<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <parent>
    <artifactId>pom-scijava</artifactId>
    <groupId>org.scijava</groupId>
    <version>31.1.0</version>
    <relativePath>pom.xml</relativePath>
  </parent>
  <modelVersion>4.0.0</modelVersion>
  <groupId>br.unifesp</groupId>
  <artifactId>SSDE</artifactId>
  <name>SSDE</name>
  <version>0.1.0</version>
  <description>Plugin for SSDE and detectability analysis in CT images</description>
  <url>https://github.com/FabioGagetti/SSDE</url>
  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/FabioGagetti/SSDE/issues</url>
  </issueManagement>
  <ciManagement>
    <system>GitHub Actions</system>
    <url>https://github.com/FabioGagetti/SSDE/actions</url>
  </ciManagement>
  <inceptionYear>2025</inceptionYear>
  <mailingLists>
    <mailingList>
      <name>Image.sc Forum</name>
      <archive>https://forum.image.sc</archive>
    </mailingList>
  </mailingLists>
  <developers>
    <developer>
      <name>Fabio Leone Gagetti</name>
      <url>https://github.com/FabioGagetti</url>
    </developer>
  </developers>
  <contributors>
    <contributor>
      <name>None</name>
    </contributor>
  </contributors>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <scm>
    <connection>scm:git:https://github.com/FabioGagetti/SSDE</connection>
    <developerConnection>scm:git:https://github.com/FabioGagetti/SSDE</developerConnection>
    <url>https://github.com/FabioGagetti/SSDE</url>
  </scm>
  <organization>
    <name>UNIFESP</name>
    <url>https://unifesp.br</url>
  </organization>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <source>1.8</source>
          <target>1.8</target>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.4.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>fat</shadedClassifierName>
              <transformers>
                <transformer>
                  <resource>META-INF/json/org.scijava.plugin.Plugin</resource>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.1.0</version>
        <configuration>
          <mainClass>br.unifesp.fisicamedica.Tester</mainClass>
          <classpathScope>test</classpathScope>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <repositories>
    <repository>
      <id>scijava.public</id>
      <url>https://maven.scijava.org/content/groups/public</url>
    </repository>
  </repositories>
  <properties>
    <license.copyrightOwners>UNIFESP</license.copyrightOwners>
    <license.licenseName>MIT License</license.licenseName>
    <package-name>br.unifesp.fisicamedica</package-name>
    <main-class>br.unifesp.fisicamedica.DetectabilidadePlugin</main-class>
  </properties>
</project>
